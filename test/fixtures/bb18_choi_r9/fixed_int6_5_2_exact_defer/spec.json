{
  "version": 2,
  "arithmetic": "int6.2.8",
  "backend": "cpu",
  "layout": "row_major",
  "column_order": "wavefront",
  "block_rows": 64,
  "executor": {
    "type": "serial"
  },
  "alpha": {
    "rule": "constant",
    "value": 1.0
  },
  "gamma0": 0.125,
  "pre_iter": 30,
  "set_max_iter": 20,
  "num_sets": 12,
  "stopping": {
    "rule": "after_leg0"
  },
  "gamma_source": {
    "type": "explicit_shapes",
    "directory": "gammas"
  },
  "window": {
    "mode": "sliding",
    "width": 5,
    "commit": 2,
    "converge_rounds": 5,
    "boundary": "exact",
    "on_failure": "defer",
    "max_deferrals": 2,
    "iteration_cap": null
  }
}
