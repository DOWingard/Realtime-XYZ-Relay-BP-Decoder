{
  "version": 2,
  "arithmetic": "int4.2.8",
  "backend": "cpu",
  "layout": "row_major",
  "column_order": "wavefront",
  "block_rows": 64,
  "executor": {
    "type": "serial"
  },
  "alpha": {
    "rule": "adaptive",
    "scaling": 1.0
  },
  "gamma0": 0.125,
  "pre_iter": 30,
  "set_max_iter": 20,
  "num_sets": 12,
  "stopping": {
    "rule": "after_n_converged",
    "count": 3
  },
  "gamma_source": {
    "type": "explicit_shapes",
    "directory": "gammas"
  },
  "window": {
    "mode": "sliding",
    "width": 4,
    "commit": 2,
    "converge_rounds": 3,
    "boundary": "uniform",
    "on_failure": "flag",
    "max_deferrals": 0,
    "iteration_cap": 150
  }
}
