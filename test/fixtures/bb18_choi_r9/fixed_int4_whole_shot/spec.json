{
  "version": 2,
  "arithmetic": "int4.2.8",
  "backend": "cpu",
  "layout": "row_major",
  "column_order": "wavefront",
  "block_rows": 64,
  "executor": {
    "type": "serial"
  },
  "alpha": {
    "rule": "adaptive",
    "scaling": 1.0
  },
  "gamma0": 0.125,
  "pre_iter": 30,
  "set_max_iter": 20,
  "num_sets": 12,
  "stopping": {
    "rule": "after_n_converged",
    "count": 3
  },
  "gamma_source": {
    "type": "explicit_shapes",
    "directory": "gammas"
  },
  "window": {
    "mode": "sliding",
    "width": 10,
    "commit": 1,
    "converge_rounds": 10,
    "boundary": "exact",
    "on_failure": "commit_anyway",
    "max_deferrals": 0,
    "iteration_cap": null
  }
}
